{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArchivDesVergessens-Launcher",
  "version": "1.0.0",
  "identifier": "com.grimoire.archivdesvergessens.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000/launcher.html",
    "frontendDist": "../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Archiv des Vergessens - Launcher",
        "label": "main",
        "url": "/launcher.html",
        "width": 1000,
        "height": 400,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": false,
    "targets": [],
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.ico"
    ]
  }
}
